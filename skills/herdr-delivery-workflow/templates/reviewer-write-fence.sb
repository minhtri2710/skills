; Write fence for one Reviewer or Architect seat (charters.md, "Write fence").
; Fill every slot with an absolute path (<herdr_home> is ~/.herdr), save as <run_dir>/fence-<peer_name>.sb,
; and start the seat's pane shell with sandbox-exec -f on that file.
; Write the <kind_state_path> line once per entry of the kind's launch-profiles runtime-state-paths
; (project_config.py --expand prints them as runtime_state_paths); it admits the path, everything
; under it, and its Write-tool temp sibling, so one form serves a directory and a file. An entry
; is literal and holds only letters, digits, space and / . _ - (project_config refuses any other
; character, placeholders included) and does not end in "/" (project_config refuses "/" too).
; In every regex line write each "." of a slot value as "\.". The last two admit the report and send
; file and each file's Write-tool temp sibling (name plus .tmp.PID.HEX), nothing else.
(version 1)
(allow default)
(deny file-write*
  (require-all
    (require-not (subpath "/private/tmp"))
    (require-not (subpath "/private/var/folders"))
    (require-not (subpath "/dev"))
    (require-not (regex #"^<kind_state_path>(/.*|\.tmp\.[0-9]+\.[0-9a-f]+)?$"))
    (require-not (subpath "<herdr_home>/heavy-lock"))
    (require-not (regex #"^<run_dir>/report-<peer_name>\.md(\.tmp\.[0-9]+\.[0-9a-f]+)?$"))
    (require-not (regex #"^<run_dir>/send-<peer_name>\.txt(\.tmp\.[0-9]+\.[0-9a-f]+)?$"))))
